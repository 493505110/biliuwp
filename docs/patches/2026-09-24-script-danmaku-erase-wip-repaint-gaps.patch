+                    if (toFiniteNumber(neighbor.props.alpha, 1) <= 0) {
+                        continue;
+                    }
+
+                    if (!neighbor.lastPaintedRect
+                        || intersectsAny(erasedRects, neighbor.lastPaintedRect)) {
                         composeElement(neighbor);
                     }
                 }
