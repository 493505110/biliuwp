diff --git a/tests/host/retained-mode.test.js b/tests/host/retained-mode.test.js
index a3f62ac..868ef78 100644
--- a/tests/host/retained-mode.test.js
+++ b/tests/host/retained-mode.test.js
@@ -1879,4 +1879,42 @@ test('D28 alpha 归零的嵌套元件必须擦掉它在主画布上的旧像素'
         + JSON.stringify(ops.map((op) => op.type + '@' + JSON.stringify(op.rect))));
 });
 
+test('D29 隐藏嵌套元件时不得擦掉同组里远处的兄弟', () => {
+    const host = loadHost();
+    host.reset(0, true, 1, true);
+    host.append([
+        scriptItem('d29', 0, 10,
+            'var group = $.createShape();'
+            + 'var a = $.createShape({ parent: group, x: 100, y: 50 });'
+            + 'a.graphics.beginFill(0xFF0000, 1);'
+            + 'a.graphics.drawRect(0, 0, 40, 40);'
+            + 'a.graphics.endFill();'
+            + 'var b = $.createShape({ parent: group, x: 400, y: 300 });'
+            + 'b.graphics.beginFill(0x00FF00, 1);'
+            + 'b.graphics.drawRect(0, 0, 40, 40);'
+            + 'b.graphics.endFill();'
+            + 'window.__a = a;')
+    ]);
+    host.runFrames(3);
+
+    const canvas = host.mainCanvas();
+    const aRect = { x: 100, y: 50, width: 40, height: 40 };
+    const bRect = { x: 400, y: 300, width: 40, height: 40 };
+    assert.ok(canvas.__marks.some((mark) => rectsOverlap(mark, aRect)), '前置条件：A 已画到主画布上');
+    assert.ok(canvas.__marks.some((mark) => rectsOverlap(mark, bRect)), '前置条件：B 已画到主画布上');
+
+    const before = canvas.__ops.length;
+    host.sandbox.__a.visible = false;
+    host.runFrames(1);
+
+    const ops = canvas.__ops.slice(before);
+    const dump = JSON.stringify(ops.map((op) => op.type + '@' + JSON.stringify(op.rect)));
+    const erasedA = ops.some((op) => op.type === 'clearRect' && rectsOverlap(op.rect, aRect));
+    const erasedB = ops.some((op) => op.type === 'clearRect' && rectsOverlap(op.rect, bRect));
+    assert.ok(erasedA, 'A 自己的旧像素必须被擦掉，否则隐藏后画面里留着它；ops=' + dump);
+    assert.ok(!erasedB,
+        '不能擦到同组里远处的兄弟 B：擦「最近祖先的整块矩形」就会连它一起抹掉，'
+        + '真作品的中段就是这样被打暗的；应按 A 自己的落点擦。ops=' + dump);
+});
+
 run();
