<Page
    x:Class="BiliBili.UWP.Pages.Home.WeeklyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliBili.UWP.Pages.Home"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:convert="using:BiliBili.UWP.Converters"
    xmlns:weeklymodels="using:BiliBili.UWP.Modules.Home.WeeklyModels"
    mc:Ignorable="d" Tag="每周必看"
    Background="{ThemeResource Bili-Background}">
    <Page.Resources>
        <convert:NumberToStringConvert x:Key="numberToStringConvert"></convert:NumberToStringConvert>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="{ThemeResource Bili-ForeColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AppBarButton Icon="Back" Foreground="White" Width="48" Height="48" x:Name="btnBack" Click="btn_back_Click"></AppBarButton>
            <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Bind Path=weeklyVM.Subject,Mode=OneWay}"></TextBlock>
            <ComboBox Grid.Column="2" x:Name="cb_Period" Margin="8 0" MinWidth="200" VerticalAlignment="Center"
                      AllowFocusOnInteraction="True"
                      ItemsSource="{x:Bind Path=weeklyVM.Periods,Mode=OneWay}"
                      SelectedItem="{x:Bind Path=weeklyVM.SelectedPeriod,Mode=OneWay}"
                      DisplayMemberPath="name"
                      SelectionChanged="cb_Period_SelectionChanged"></ComboBox>
        </Grid>

        <toolkit:AdaptiveGridView Grid.Row="1"
                                  ItemHeight="100"
                                  DesiredWidth="600"
                                  Padding="8"
                                  ItemsSource="{x:Bind Path=weeklyVM.Items,Mode=OneWay}"
                                  ItemClick="List_weekly_ItemClick"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  StretchContentForSingleRow="False">
            <toolkit:AdaptiveGridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4"></Setter>
                    <Setter Property="Padding" Value="0"></Setter>
                    <Setter Property="Background" Value="{ThemeResource Bili-List-Background}"></Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                </Style>
            </toolkit:AdaptiveGridView.ItemContainerStyle>
            <toolkit:AdaptiveGridView.ItemTemplate>
                <DataTemplate x:DataType="weeklymodels:WeeklyVideoModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="4">
                            <toolkit:ImageEx IsCacheEnabled="True" PlaceholderSource="ms-appx:///Assets/Logo/PI160_100.png"
                                             Stretch="UniformToFill"
                                             Source="{x:Bind Path=cover,Converter={StaticResource imageConvert},ConverterParameter='120h'}"></toolkit:ImageEx>
                            <Border CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4 2" Background="#99000000">
                                <TextBlock Foreground="White" FontSize="12" Text="{x:Bind durationText}"></TextBlock>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4 0 0 0">
                            <TextBlock MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{x:Bind title}"></TextBlock>
                            <Border Margin="0 2 0 0" Visibility="{x:Bind hasReason}" HorizontalAlignment="Left" Padding="4 0" CornerRadius="2"
                                    Background="{ThemeResource Bili-ForeColor}">
                                <TextBlock FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" Text="{x:Bind rcmd_reason}"></TextBlock>
                            </Border>
                            <TextBlock Margin="0 2 0 0" TextTrimming="CharacterEllipsis" Foreground="Gray" Text="{x:Bind upName}"></TextBlock>
                            <TextBlock Margin="0 2 0 0" TextTrimming="CharacterEllipsis" Foreground="Gray">播放:<Run Text="{x:Bind Path=viewCount,Converter={StaticResource numberToStringConvert}}"></Run></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </toolkit:AdaptiveGridView.ItemTemplate>
        </toolkit:AdaptiveGridView>

        <ProgressRing Width="56" Height="56" Grid.Row="1" IsActive="True" Visibility="{x:Bind Path=weeklyVM.Loading,Mode=OneWay}"></ProgressRing>
    </Grid>
</Page>
