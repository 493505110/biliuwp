<Page
    x:Class="BiliBili.UWP.Pages.User.UserCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliBili.UWP.Pages.User"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:modules="using:BiliBili.UWP.Modules.BiliBili.UWP.Modules.UserSubmitVideoModels"
    xmlns:controls="using:BiliBili.UWP.Controls"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:convert="using:BiliBili.UWP.Converters"
    xmlns:dynModels="using:BiliBili.UWP.Models"
    Background="{ThemeResource Bili-Background}">
    <Page.Resources>
        <convert:DatetimeConvert x:Key="time"/>
        <convert:NumberToStringConvert x:Key="numberToStringConvert"/>
        <DataTemplate x:Key="UserSpaceVideoListTemplate" x:DataType="dynModels:UserSpaceVideo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Margin="4">
                    <toolkit:ImageEx Source="{x:Bind Cover,Converter={StaticResource imageConvert},ConverterParameter='120h'}" IsCacheEnabled="True"
                        PlaceholderSource="ms-appx:///Assets/Thumbnails/Placeholde.png" Stretch="UniformToFill"/>
                    <Border CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4,2" Background="#99000000">
                        <TextBlock Text="{x:Bind Duration}" Foreground="White" FontSize="12"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="Gray" Margin="0,4,0,0">观看:<Run Text="{x:Bind Views,Converter={StaticResource numberToStringConvert}}"/> 弹幕:<Run Text="{x:Bind DanmakuText,Converter={StaticResource numberToStringConvert}}"/></TextBlock>
                    <TextBlock Foreground="Gray" Margin="0,4,0,0" Visibility="{x:Bind HasPublicationTime}">发表于 <Run Text="{x:Bind PublishedAt,Converter={StaticResource time},ConverterParameter='ts'}"/></TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CollectionPreviewTemplate" x:DataType="dynModels:UserSpaceVideo">
            <Grid Width="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>
                <Grid>
                    <toolkit:ImageEx Source="{x:Bind Cover,Converter={StaticResource imageConvert},ConverterParameter='320w_200h_1e_1c'}"
                                     IsCacheEnabled="True" Stretch="Uniform"
                                     PlaceholderSource="ms-appx:///Assets/Logo/PI160_100.png"/>
                    <Grid VerticalAlignment="Bottom" Padding="8">
                        <Grid.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#CC000005" Offset="0.993"/>
                                <GradientStop Color="#00000000" Offset="0"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,4,0">观看:<Run Text="{x:Bind Views,Converter={StaticResource numberToStringConvert}}"/> 弹幕:<Run Text="{x:Bind DanmakuText,Converter={StaticResource numberToStringConvert}}"/></TextBlock>
                        <TextBlock Grid.Column="1" Text="{x:Bind Duration}" HorizontalAlignment="Right" FontSize="12" Foreground="White"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind Title}" Margin="8,4,8,0" MaxLines="2"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="{x:Bind PublishedAt,Converter={StaticResource time},ConverterParameter='ts'}"
                           Visibility="{x:Bind HasPublicationTime}" Margin="8,0,8,4" FontSize="12" Foreground="Gray"/>
            </Grid>
        </DataTemplate>
        <!--让ListView条目横向撑满-->
        <Style x:Key="ListViewItemStretchStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <DataTemplate x:Key="DynItemTemplate" x:DataType="dynModels:SpaceDynItemVM">
            <StackPanel Padding="12 10 12 10"
                        BorderBrush="{ThemeResource Bili-BorderColor}"
                        BorderThickness="0 0 0 1">
                <!--作者行-->
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="36" Height="36">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{x:Bind AuthorFace}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6 0 0 0">
                        <TextBlock Text="{x:Bind AuthorName}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{x:Bind PubTime}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <!--文字内容-->
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0 0 0 8"
                           Visibility="{x:Bind TextVisible}" MaxLines="6"
                           TextTrimming="CharacterEllipsis"/>
                <!--图片网格。Tag绑定父VM方便click handler取到原图列表-->
                <GridView Visibility="{x:Bind ImagesVisible}" ItemsSource="{x:Bind Images}"
                          Tag="{x:Bind}"
                          SelectionMode="None" IsItemClickEnabled="True" Margin="0 0 0 8"
                          ItemClick="ImgGrid_ItemClick">
                    <GridView.ItemTemplate>
                        <!--用Binding而非x:Bind，让string通过类型转换器自动装载-->
                        <DataTemplate>
                            <toolkit:ImageEx Source="{Binding}" IsCacheEnabled="True"
                                             Width="96" Height="96" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <!--视频卡片-->
                <Border Visibility="{x:Bind VideoVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource Bili-List-Background}" CornerRadius="4">
                    <Grid Height="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <toolkit:ImageEx Source="{x:Bind VideoCover}" IsCacheEnabled="True"
                                         Stretch="UniformToFill" CornerRadius="4 0 0 4"/>
                        <Border Grid.Column="0" CornerRadius="0 0 0 4"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="0 0 4 4" Padding="4 1" Background="#99000000">
                            <TextBlock Text="{x:Bind VideoDuration}" Foreground="White" FontSize="11"/>
                        </Border>
                        <StackPanel Grid.Column="1" Padding="8 6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VideoTitle}" FontWeight="SemiBold"
                                       MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE714;" FontSize="11" Foreground="Gray" Margin="0 0 3 0"/>
                                <TextBlock Text="{x:Bind VideoPlay}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <!--文章卡片-->
                <Border Visibility="{x:Bind ArticleVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="4">
                    <StackPanel Padding="8">
                        <toolkit:ImageEx Visibility="{x:Bind ArticleCoverVisible}" Source="{x:Bind ArticleCover}"
                                         IsCacheEnabled="True" MaxHeight="120" Stretch="UniformToFill"
                                         Margin="0 0 0 6"/>
                        <TextBlock Text="{x:Bind ArticleTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ArticleDesc}" Foreground="Gray" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12"/>
                    </StackPanel>
                </Border>
                <!--转发摘要-->
                <Border Visibility="{x:Bind ForwardVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="4" Padding="8">
                    <TextBlock Text="{x:Bind ForwardSummary}" Foreground="Gray" MaxLines="4"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </Border>
                <!--统计行-->
                <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72D;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind ForwardStr}" Foreground="Gray" FontSize="12" Margin="0 0 16 0"/>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F2;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind CommentStr}" Foreground="Gray" FontSize="12" Margin="0 0 16 0"/>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB51;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind LikeStr}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="{x:Bind Path=userCenterVM.top_image,Converter={StaticResource imageConvert2},ConverterParameter='240h',Mode=OneWay}" Stretch="UniformToFill"/>
            </Grid.Background>
            <Border Background="#4C000000" />
            <StackPanel RequestedTheme="Dark" VerticalAlignment="Center"  HorizontalAlignment="Center" >
               
                <Grid Width="64" >
                    <Grid>
                        <Ellipse Width="64" Height="64" >
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind Path=userCenterVM.UserCenterDetail.card.face,Converter={StaticResource imageConvert2},ConverterParameter='100w',Mode=OneWay}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <HyperlinkButton x:Name="btn_verify" Click="btn_verify_Click" ToolTipService.ToolTip="{x:Bind Path=userCenterVM.UserCenterDetail.card.official_verify.desc,Mode=OneWay}" Padding="0" Margin="0" VerticalAlignment="Bottom"  HorizontalAlignment="Right">
                            <Image Width="24" Height="24" Source="{x:Bind Path=userCenterVM.UserCenterDetail.card.official_verify.icon,Mode=OneWay}"></Image>
                        </HyperlinkButton>
                    </Grid>
                </Grid>
                
                <TextBlock TextAlignment="Center" FontWeight="Bold" Margin="0 2 0 0" Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.name,Mode=OneWay}"></TextBlock>
                <Grid Visibility="{x:Bind Path=userCenterVM.UserCenterDetail.card.showPrInfo,Mode=OneWay}" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE814;"  Foreground="Orange"/>
                    <TextBlock Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.pr_info.content,Mode=OneWay}" Margin="4 0 0 0" VerticalAlignment="Center" Grid.Column="1" Foreground="Orange"></TextBlock>
                </Grid>
                
                <StackPanel Margin="0 2 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Visibility="{x:Bind Path=userCenterVM.UserCenterDetail.card.isVip,Mode=OneWay}" Margin="4,0"  CornerRadius="4"  Background="#FFFFC937">
                        <TextBlock  Foreground="White" Margin="4,2" FontSize="12" Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.vip.vipText,Mode=OneWay}"></TextBlock>
                    </Border>
                    <Border  CornerRadius="4"  Background="{x:Bind Path=userCenterVM.UserCenterDetail.card.level_info.level_color,Mode=OneWay}" >
                        <TextBlock  Foreground="White" Margin="4,2" FontSize="12">
                                                <Run>LV</Run>
                                                <Run Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.level_info.current_level,Mode=OneWay}"></Run>
                        </TextBlock>
                    </Border>
                    <TextBlock Visibility="{x:Bind Path=userCenterVM.is_self,Mode=OneWay}" VerticalAlignment="Center" Foreground="White" Margin="4,0" FontSize="12">
                                                <Run>经验</Run>
                                                <Run Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.level_info.current_exp,Mode=OneWay}"></Run>
                                                  <Run>/</Run>
                                              <Run Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.level_info.next_exp,Mode=OneWay}"></Run>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 2 0 0">
                    <TextBlock Text="关注" FontSize="14"  Foreground="White" Margin="4 0"/>
                    <TextBlock Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.attention,Mode=OneWay}" FontSize="14"  Foreground="White" Margin="0,0,8,0"  FontWeight="Bold"/>
                    <TextBlock Text="粉丝" FontSize="14" Margin="4 0"  Foreground="White"/>
                    <TextBlock Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.fans,Mode=OneWay}" FontSize="14"  Foreground="White"  FontWeight="Bold"/>
                </StackPanel>
                
                <TextBlock TextAlignment="Center" IsTextSelectionEnabled="True" FontSize="14" Margin="0 2 0 0" Text="{x:Bind Path=userCenterVM.UserCenterDetail.card.sign,Mode=OneWay}"></TextBlock>
            </StackPanel>
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <AppBarButton x:Name="btnBack" Click="btnBack_Click" Width="48" Height="48" Icon="Back" Foreground="White"></AppBarButton>
                <StackPanel Visibility="{x:Bind Path=userCenterVM.is_self,Converter={StaticResource display},Mode=OneWay}" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnOpenLiveRoom" Click="btnOpenLiveRoom_Click" Visibility="{x:Bind Path=userCenterVM.UserCenterDetail.living,Mode=OneWay}" Margin="0 0 8 0" MinWidth="80"  Background="{ThemeResource Bili-Color}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE116;" FontSize="14" Foreground="White" Margin="0 0 8 0"/>
                            <TextBlock Foreground="White">正在直播</TextBlock>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="btnAddFollow" Click="btnAddFollow_Click" Visibility="{x:Bind Path=userCenterVM.UserCenterDetail.is_follow,Converter={StaticResource display},Mode=OneWay}" Margin="0 0 8 0" MinWidth="80" Background="{ThemeResource Bili-Color}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE109;" FontSize="14" Foreground="White" Margin="0 0 8 0"/>
                            <TextBlock Foreground="White">关注</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCancelFollow" Click="btnCancelFollow_Click" Visibility="{x:Bind Path=userCenterVM.UserCenterDetail.is_follow,Mode=OneWay}" Margin="0 0 8 0" MinWidth="80"  Background="Gray">
                        <TextBlock Foreground="White">取消关注</TextBlock>
                    </Button>
                  
                    <Button Margin="0 0 8 0" MinWidth="80" Visibility="Collapsed" Background="{ThemeResource Bili-Color}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE119;" FontSize="14" Foreground="White" Margin="0 0 8 0"/>
                            <TextBlock Foreground="White">私信</TextBlock>
                        </StackPanel>
                    </Button>
                  
                </StackPanel>
                <StackPanel Visibility="{x:Bind Path=userCenterVM.is_self,Mode=OneWay}" Grid.Column="2" Orientation="Horizontal">
                    <AppBarButton x:Name="btnEditProfile" Click="btnEditProfile_Click" Width="48" Height="48" Icon="Edit" Foreground="White"></AppBarButton>
                </StackPanel>
            </Grid>
            
        </Grid>
        <Pivot x:Name="pivot" SelectionChanged="pivot_SelectionChanged" Grid.Row="1" >
            <PivotItem Margin="0">
                <PivotItem.Header>
                    <TextBlock FontSize="18">投稿</TextBlock>
                </PivotItem.Header>
                <Grid>
                    <toolkit:AdaptiveGridView 
                Padding="8 4" 
                ItemHeight="100" 
                DesiredWidth="500" 
                StretchContentForSingleRow="False" 
                SelectionMode="None" 
                IsItemClickEnabled="True" 
                ItemsSource="{x:Bind Path=userCenterVM.SubmitVideos,Mode=OneWay}"
                ItemClick="SubmitVideo_ItemClick"
                OneRowModeEnabled="False">
                        <toolkit:AdaptiveGridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4"></Setter>
                            </Style>
                        </toolkit:AdaptiveGridView.ItemContainerStyle>
                        <toolkit:AdaptiveGridView.ItemTemplate>
                            <DataTemplate x:DataType="modules:SubmitVideoItemModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="4">
                                        <toolkit:ImageEx IsCacheEnabled="True" PlaceholderSource="ms-appx:///Assets/Thumbnails/Placeholde.png" Stretch="UniformToFill" Source="{x:Bind Path=pic,Converter={StaticResource imageConvert},ConverterParameter='120h'}"></toolkit:ImageEx>
                                        <Border CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4 2" Background="#99000000">
                                            <TextBlock Foreground="White" FontSize="12" Text="{x:Bind length}"></TextBlock>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="4 0 0 0" >
                                        <TextBlock MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{x:Bind title}"></TextBlock>

                                        <TextBlock Foreground="Gray" Margin="0 4 0 0">观看:<Run Text="{x:Bind Path=play,Converter={StaticResource numberToStringConvert}}"/> 弹幕:<Run Text="{x:Bind Path=video_review,Converter={StaticResource numberToStringConvert}}"/></TextBlock>
                                        <TextBlock Foreground="Gray" Margin="0 4 0 0">发表于 <Run Text="{x:Bind Path=created,Converter={StaticResource time},ConverterParameter='ts'}"/></TextBlock>
                                    </StackPanel>
                                    <!--<TextBlock  Grid.Row="2" Margin="4 0 4 4" FontSize="12" Foreground="Gray" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding desc}"></TextBlock>-->
                                </Grid>
                            </DataTemplate>
                        </toolkit:AdaptiveGridView.ItemTemplate>
                        <toolkit:AdaptiveGridView.Footer>
                            <ProgressRing IsActive="True" HorizontalAlignment="Center" Visibility="{x:Bind Path=userCenterVM.SubmitVideos.IsLoading,Mode=OneWay}"></ProgressRing>
                        </toolkit:AdaptiveGridView.Footer>
                    </toolkit:AdaptiveGridView>
                    <controls:RoundButton x:Name="btnRefreshSubmitVideos" Click="btnRefreshSubmitVideos_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12">
                        <SymbolIcon Symbol="Refresh" Foreground="White"></SymbolIcon>
                    </controls:RoundButton>
                    <TextBlock Visibility="{x:Bind Path=userCenterVM.SubmitVideos.Count,Converter={StaticResource display},ConverterParameter=0,Mode=OneWay}"  Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">什么都没有...</TextBlock>
                </Grid>
                
            </PivotItem>
            <PivotItem Margin="0">
                <PivotItem.Header>
                    <TextBlock FontSize="18">动态</TextBlock>
                </PivotItem.Header>
                <Grid>
                    <ScrollViewer x:Name="sv_dynamic" ViewChanged="sv_dynamic_ViewChanged">
                        <ListView x:Name="ls_new_dynamic"
                                  SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="ls_new_dynamic_ItemClick"
                                  ItemTemplate="{StaticResource DynItemTemplate}"
                                  ItemContainerStyle="{StaticResource ListViewItemStretchStyle}"/>
                    </ScrollViewer>
                    <ProgressRing x:Name="pr_Load" IsActive="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tb_dynEmpty" Visibility="Collapsed" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center">还没有动态</TextBlock>
                </Grid>
            </PivotItem>
            <PivotItem x:Name="pi_Collections" Margin="0">
                <PivotItem.Header>
                    <TextBlock FontSize="18">合集与系列</TextBlock>
                </PivotItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Margin="8,0" Visibility="{x:Bind spaceCollectionsVM.ShowVideos,Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Click="CollectionsBack_Click" Width="48" Height="32" MinWidth="0" MinHeight="0"
                                Padding="0" BorderThickness="0" Background="Transparent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="返回合集与系列" AutomationProperties.Name="返回合集与系列"
                                Visibility="{x:Bind spaceCollectionsVM.ShowVideos,Mode=OneWay}">
                            <Viewbox Width="16" Height="16">
                                <SymbolIcon Symbol="Back"/>
                            </Viewbox>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{x:Bind spaceCollectionsVM.Title,Mode=OneWay}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontSize="16"/>
                    </Grid>
                    <ListView Grid.Row="1" Padding="8,4" SelectionMode="None"
                        ItemContainerStyle="{StaticResource ListViewItemStretchStyle}"
                        ItemsSource="{x:Bind spaceCollectionsVM.Collections,Mode=OneWay}"
                        Visibility="{x:Bind spaceCollectionsVM.ShowCollectionList,Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dynModels:UserSpaceCollection">
                                <Border Margin="0,0,0,12" Padding="0,4,0,12" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource Bili-BorderColor}">
                                    <StackPanel>
                                        <Grid Margin="4,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" FontSize="18">
                                                <Run Text="{x:Bind Heading}"/><Run Text=" · "/><Run Text="{x:Bind Count}" Foreground="Gray"/>
                                            </TextBlock>
                                            <HyperlinkButton Grid.Column="1" Content="查看更多" Tag="{x:Bind}" Click="CollectionMore_Click" Foreground="Gray"/>
                                        </Grid>
                                        <GridView Padding="0" SelectionMode="None" IsItemClickEnabled="True" VerticalAlignment="Top"
                                            HorizontalContentAlignment="Left"
                                            ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ItemsSource="{x:Bind PreviewVideos}" ItemTemplate="{StaticResource CollectionPreviewTemplate}"
                                            ItemClick="CollectionVideo_ItemClick" Visibility="{x:Bind HasPreviewVideos}">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Margin" Value="8"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                                    <Setter Property="Background" Value="{ThemeResource Bili-List-Background}"/>
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                        </GridView>
                                        <TextBlock Text="暂无可预览的视频" Margin="4,8" Foreground="Gray"
                                                   Visibility="{x:Bind HasPreviewVideos,Converter={StaticResource display}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <StackPanel>
                                <TextBlock Text="{x:Bind spaceCollectionsVM.Status,Mode=OneWay}" Foreground="Gray"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                <HyperlinkButton Click="CollectionsLoadMore_Click" Foreground="Gray" HorizontalAlignment="Center"
                                                 Visibility="{x:Bind spaceCollectionsVM.CanLoadMore,Mode=OneWay}">
                                    <TextBlock>加载更多</TextBlock>
                                </HyperlinkButton>
                                <ProgressRing IsActive="True" HorizontalAlignment="Center"
                                              Visibility="{x:Bind spaceCollectionsVM.IsLoading,Mode=OneWay}"/>
                            </StackPanel>
                        </ListView.Footer>
                    </ListView>
                    <toolkit:AdaptiveGridView Grid.Row="1" Padding="8,4" ItemHeight="100" DesiredWidth="500"
                        StretchContentForSingleRow="False" SelectionMode="None" IsItemClickEnabled="True"
                        ItemsSource="{x:Bind spaceCollectionsVM.Videos,Mode=OneWay}" ItemClick="CollectionVideo_ItemClick"
                        ItemTemplate="{StaticResource UserSpaceVideoListTemplate}"
                        Visibility="{x:Bind spaceCollectionsVM.ShowVideos,Mode=OneWay}">
                        <toolkit:AdaptiveGridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </toolkit:AdaptiveGridView.ItemContainerStyle>
                        <toolkit:AdaptiveGridView.Footer>
                            <StackPanel>
                                <TextBlock Text="{x:Bind spaceCollectionsVM.Status,Mode=OneWay}" Foreground="Gray"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                <HyperlinkButton Click="CollectionsLoadMore_Click" Foreground="Gray" HorizontalAlignment="Center"
                                                 Visibility="{x:Bind spaceCollectionsVM.CanLoadMore,Mode=OneWay}">
                                    <TextBlock>加载更多</TextBlock>
                                </HyperlinkButton>
                                <ProgressRing IsActive="True" HorizontalAlignment="Center"
                                              Visibility="{x:Bind spaceCollectionsVM.IsLoading,Mode=OneWay}"/>
                            </StackPanel>
                        </toolkit:AdaptiveGridView.Footer>
                    </toolkit:AdaptiveGridView>
                    <TextBlock Grid.RowSpan="2" Text="{x:Bind spaceCollectionsVM.Status,Mode=OneWay}" Foreground="Gray"
                               Visibility="{x:Bind spaceCollectionsVM.ShowEmptyCollections,Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="16"/>
                </Grid>
            </PivotItem>
            <PivotItem x:Name="pi_Favorites" Margin="0" AutomationProperties.Name="收藏">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <!-- 仅补偿“收”的视觉高度，保留原字体和页签布局尺寸。 -->
                        <TextBlock Text="收" FontSize="18" AutomationProperties.AccessibilityView="Raw">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock FontSize="18" AutomationProperties.AccessibilityView="Raw">藏</TextBlock>
                    </StackPanel>
                </PivotItem.Header>
                <Grid>
                    <Grid SizeChanged="FavoritesLayout_SizeChanged"
                          Visibility="{x:Bind spaceFavoritesVM.ShowContent,Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="favoriteFoldersColumn" Width="180"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ListView x:Name="favoriteFoldersList" Grid.RowSpan="2" Margin="4,8" SelectionMode="Single"
                                  ItemsSource="{x:Bind spaceFavoritesVM.Folders,Mode=OneWay}"
                                  SelectedItem="{x:Bind spaceFavoritesVM.SelectedFolder,Mode=OneWay}"
                                  SelectionChanged="FavoriteFolder_SelectionChanged">
                            <ListView.Header>
                                <TextBlock Text="{x:Bind spaceFavoritesVM.FolderHeader,Mode=OneWay}" Foreground="Gray" Margin="8,4,8,12"/>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dynModels:UserSpaceFavoriteFolder">
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <Grid Grid.Column="1" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ComboBox x:Name="favoriteFoldersCombo" Visibility="Collapsed" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind spaceFavoritesVM.Folders,Mode=OneWay}" DisplayMemberPath="DisplayTitle"
                                          PlaceholderText="选择收藏夹" SelectedItem="{x:Bind spaceFavoritesVM.SelectedFolder,Mode=OneWay}"
                                          SelectionChanged="FavoriteFolder_SelectionChanged"/>
                                <TextBlock x:Name="favoriteFolderTitle" Text="{x:Bind spaceFavoritesVM.Title,Mode=OneWay}"
                                           FontSize="18" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind spaceFavoritesVM.Summary,Mode=OneWay}" Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="刷新" Click="FavoritesRefresh_Click" Foreground="Gray" VerticalAlignment="Top"/>
                        </Grid>
                        <toolkit:AdaptiveGridView Grid.Column="1" Grid.Row="1" Padding="8,4" SelectionMode="None"
                            DesiredWidth="500" ItemHeight="100" StretchContentForSingleRow="False" IsItemClickEnabled="True"
                            ItemsSource="{x:Bind spaceFavoritesVM.Videos,Mode=OneWay}" ItemTemplate="{StaticResource UserSpaceVideoListTemplate}"
                            ItemClick="FavoriteVideo_ItemClick">
                            <toolkit:AdaptiveGridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="4"/>
                                </Style>
                            </toolkit:AdaptiveGridView.ItemContainerStyle>
                            <toolkit:AdaptiveGridView.Footer>
                                <StackPanel Margin="8">
                                    <TextBlock Text="{x:Bind spaceFavoritesVM.Status,Mode=OneWay}" Foreground="Gray"
                                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                    <HyperlinkButton Content="加载更多" Click="FavoritesLoadMore_Click" Foreground="Gray" HorizontalAlignment="Center"
                                                     Visibility="{x:Bind spaceFavoritesVM.ShowLoadMore,Mode=OneWay}"/>
                                    <HyperlinkButton Content="重试" Click="FavoritesRetry_Click" Foreground="Gray" HorizontalAlignment="Center"
                                                     Visibility="{x:Bind spaceFavoritesVM.CanRetry,Mode=OneWay}"/>
                                    <ProgressRing IsActive="True" HorizontalAlignment="Center"
                                                  Visibility="{x:Bind spaceFavoritesVM.IsLoading,Mode=OneWay}"/>
                                </StackPanel>
                            </toolkit:AdaptiveGridView.Footer>
                        </toolkit:AdaptiveGridView>
                    </Grid>
                    <TextBlock Text="{x:Bind spaceFavoritesVM.Status,Mode=OneWay}" Foreground="Gray"
                               Visibility="{x:Bind spaceFavoritesVM.IsEmpty,Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="16"/>
                </Grid>
            </PivotItem>
        </Pivot>
        <ProgressRing Grid.RowSpan="2" IsActive="True"  VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind Path=userCenterVM.Loading,Mode=OneWay}"></ProgressRing>
    </Grid>
</Page>
