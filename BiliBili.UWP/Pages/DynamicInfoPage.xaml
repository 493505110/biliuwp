<Page xmlns:Controls="using:BiliBili.UWP.Controls"
    x:Class="BiliBili.UWP.Pages.DynamicInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliBili.UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:dynModels="using:BiliBili.UWP.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ListViewItemStretchStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!--动态卡片模板（与 UserCenterPage 共享同一套布局）-->
        <DataTemplate x:Key="DynItemTemplate" x:DataType="dynModels:SpaceDynItemVM">
            <StackPanel Padding="12 10 12 10"
                        BorderBrush="{ThemeResource Bili-BorderColor}"
                        BorderThickness="0 0 0 1">
                <!--作者行-->
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="36" Height="36">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{x:Bind AuthorFace}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6 0 0 0">
                        <TextBlock Text="{x:Bind AuthorName}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{x:Bind PubTime}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <!--文字内容-->
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0 0 0 8"
                           Visibility="{x:Bind TextVisible}" MaxLines="20"
                           TextTrimming="CharacterEllipsis"/>
                <!--图片网格-->
                <GridView Visibility="{x:Bind ImagesVisible}" ItemsSource="{x:Bind Images}"
                          Tag="{x:Bind}"
                          SelectionMode="None" IsItemClickEnabled="True" Margin="0 0 0 8"
                          ItemClick="ImgGrid_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <toolkit:ImageEx Source="{Binding}" IsCacheEnabled="True"
                                             Width="96" Height="96" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <!--视频卡片-->
                <Border Visibility="{x:Bind VideoVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="4">
                    <Grid Height="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <toolkit:ImageEx Source="{x:Bind VideoCover}" IsCacheEnabled="True"
                                         Stretch="UniformToFill" CornerRadius="4 0 0 4"/>
                        <Border Grid.Column="0" CornerRadius="0 0 0 4"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="0 0 4 4" Padding="4 1" Background="#99000000">
                            <TextBlock Text="{x:Bind VideoDuration}" Foreground="White" FontSize="11"/>
                        </Border>
                        <StackPanel Grid.Column="1" Padding="8 6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind VideoTitle}" FontWeight="SemiBold"
                                       MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="Gray" Margin="0 0 3 0"/>
                                <TextBlock Text="{x:Bind VideoPlay}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <!--文章卡片-->
                <Border Visibility="{x:Bind ArticleVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="4">
                    <StackPanel Padding="8">
                        <toolkit:ImageEx Visibility="{x:Bind ArticleCoverVisible}" Source="{x:Bind ArticleCover}"
                                         IsCacheEnabled="True" MaxHeight="120" Stretch="UniformToFill"
                                         Margin="0 0 0 6"/>
                        <TextBlock Text="{x:Bind ArticleTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ArticleDesc}" Foreground="Gray" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12"/>
                    </StackPanel>
                </Border>
                <!--转发摘要-->
                <Border Visibility="{x:Bind ForwardVisible}" Margin="0 0 0 8"
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="4" Padding="8">
                    <TextBlock Text="{x:Bind ForwardSummary}" Foreground="Gray" MaxLines="4"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </Border>
                <!--统计行-->
                <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                    <FontIcon Glyph="&#xE8BA;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind ForwardStr}" Foreground="Gray" FontSize="12" Margin="0 0 16 0"/>
                    <FontIcon Glyph="&#xE8F2;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind CommentStr}" Foreground="Gray" FontSize="12" Margin="0 0 16 0"/>
                    <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="Gray" Margin="0 0 4 0"/>
                    <TextBlock Text="{x:Bind LikeStr}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <!--转发列表行模板-->
        <DataTemplate x:Key="ForwardItemTemplate" x:DataType="dynModels:SpaceDynForwardItemVM">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <HyperlinkButton Padding="0" Margin="0" Grid.RowSpan="2"
                                 Tag="{x:Bind Mid}" Click="btn_ForwardUser_Click">
                    <Ellipse Height="36" Width="36">
                        <Ellipse.Fill>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{x:Bind FaceThumb}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </HyperlinkButton>
                <TextBlock Grid.Column="1" Margin="8 0" VerticalAlignment="Bottom"
                           Text="{x:Bind Name}"/>
                <TextBlock Grid.Column="1" Grid.Row="1" FontSize="12" Foreground="Gray"
                           Margin="8 0" VerticalAlignment="Top" Text="{x:Bind PubTime}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource Bili-Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="grid_Top" Background="{ThemeResource Bili-ForeColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <AppBarButton x:Name="btn_Back" Click="btn_Back_Click" Foreground="White" Width="48" Icon="Back" Height="48"/>
            <TextBlock x:Name="txt_Header" TextTrimming="CharacterEllipsis" Grid.Column="1"
                       Margin="5 0" VerticalAlignment="Center" Foreground="White">动态详情</TextBlock>
            <AppBarButton Width="48" Height="48" Icon="More" Grid.Column="2" Foreground="White">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="btn_Share" Click="btn_Share_Click">分享</MenuFlyoutItem>
                        <MenuFlyoutItem>举报</MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="btn_Delete" Click="btn_Delete_Click" Visibility="Collapsed">删除</MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </Grid>

        <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                <!--动态正文-->
                <ListView x:Name="dynList"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemTemplate="{StaticResource DynItemTemplate}"
                          ItemContainerStyle="{StaticResource ListViewItemStretchStyle}"/>

                <Pivot x:Name="pivot" SelectionChanged="pivot_SelectionChanged"
                       Background="{ThemeResource Bili-List-Background}" Margin="0 8">
                    <PivotItem Margin="0">
                        <PivotItem.Header>
                            <TextBlock FontSize="16">转发</TextBlock>
                        </PivotItem.Header>
                        <Grid>
                            <StackPanel>
                                <ListView x:Name="ls_repost"
                                          SelectionMode="None" IsItemClickEnabled="False"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ItemTemplate="{StaticResource ForwardItemTemplate}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="BorderThickness" Value="0 0 0 1"/>
                                            <Setter Property="BorderBrush" Value="#33808080"/>
                                            <Setter Property="Padding" Value="12"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <HyperlinkButton x:Name="btn_LoadMoreRepost"
                                                 Click="btn_LoadMoreRepost_Click"
                                                 Visibility="Collapsed"
                                                 HorizontalAlignment="Center">加载更多</HyperlinkButton>
                            </StackPanel>
                            <TextBlock x:Name="noRepost" Foreground="Gray"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0 24">还没有人转发</TextBlock>
                        </Grid>
                    </PivotItem>
                    <PivotItem Margin="0">
                        <PivotItem.Header>
                            <TextBlock FontSize="16">评论</TextBlock>
                        </PivotItem.Header>
                        <Grid BorderThickness="0 1 0 0" BorderBrush="#33808080">
                            <Controls:CommentV2Control x:Name="comment"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar x:Name="pr_Load" Grid.Row="1" VerticalAlignment="Top"
                     Background="#00000000" IsIndeterminate="True" Visibility="Collapsed"/>
    </Grid>
</Page>
