<UserControl
    x:Class="BiliBili.UWP.Controls.InteractiveDanmakuControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="InteractiveDanmakuOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource Bili-ForeColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{ThemeResource Bili-ForeColor-Dark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource Bili-Color}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource Bili-Color}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="InteractiveDanmakuResultOptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource InteractiveDanmakuOptionButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource Bili-ForeColor-Dark}" />
            <Setter Property="BorderBrush" Value="{ThemeResource Bili-ForeColor-Dark}" />
        </Style>
        <Style
            x:Key="InteractiveDanmakuSelectedResultOptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource InteractiveDanmakuResultOptionButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource Bili-Highlight-TextColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style
            x:Key="InteractiveDanmakuSelectedOptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource InteractiveDanmakuOptionButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource Bili-Highlight-TextColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border
            x:Name="panel"
            MaxWidth="460"
            MaxHeight="320"
            Margin="16,16,16,112"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#E6202020"
            BorderBrush="{ThemeResource Bili-ForeColor}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border
                        x:Name="iconBorder"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        CornerRadius="21"
                        Visibility="Collapsed">
                        <Image
                            x:Name="iconImage"
                            Width="42"
                            Height="42"
                            Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="titleText"
                            Foreground="{ThemeResource Bili-Highlight-TextColor}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="summaryText"
                            Margin="0,6,0,0"
                            Foreground="{ThemeResource Bili-FontColor-Light}"
                            FontSize="13"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Grid
                    x:Name="optionsPanel"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch" />
                <TextBlock
                    x:Name="statusText"
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource Bili-Highlight-TextColor}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
